# Copiá este archivo a .env y completá los valores reales.
# .env está ignorado por git y nunca se publica: Wrangler sólo usa public/.

# Supabase
SUPABASE_PROJECT_REF=TU_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=TU_SUPABASE_PUBLISHABLE_KEY
SUPABASE_DB_PASSWORD=TU_DB_PASSWORD

# Mercado Pago
# Sólo se necesita el Access Token: el checkout es Checkout Pro alojado y
# el navegador nunca ve claves de Mercado Pago.
MP_ACCESS_TOKEN=TU_ACCESS_TOKEN_MP
MP_WEBHOOK_SECRET=

# Debe coincidir con el dominio público del sitio.
CORS_ALLOWED_ORIGIN=https://TU_DOMINIO.workers.dev
