---
import { products, accessories, waHref } from '../data/catalog';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h4>Temple XV</h4>
        <p>
          El carácter se forja. En el rugby, la fuerza está en la cabeza y en levantarse después de
          cada tackle.
        </p>
      </div>
      <div>
        <h4>Productos</h4>
        <ul class="footer-list" role="list">
          {products.map((p) => <li><a href="/coleccion">{p.name}</a></li>)}
          {accessories.map((a) => <li><a href="/accesorios">{a.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Contacto</h4>
        <ul class="footer-list" role="list">
          <li><a href={waHref} data-wa="Hola%20Temple%20XV">WhatsApp</a></li>
          <li>
            <a href="https://www.instagram.com/temple.argentina" target="_blank" rel="noopener">Instagram</a>
          </li>
          <li><a href="mailto:hola@temple.art">Email</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <span>Temple XV · Argentina</span>
    </div>
  </div>
</footer>
