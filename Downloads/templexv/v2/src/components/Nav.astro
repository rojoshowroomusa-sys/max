---
import { routes, currentRoute } from '../data/catalog';

const { pathname } = Astro.url;
const active = currentRoute(pathname);
---

<div class="field-line" aria-hidden="true"></div>
<a class="skip" href="#contenido">Saltar al contenido</a>

<nav class="nav" id="nav" data-open="false" aria-label="Principal">
  <div class="wrap nav-inner">
    <a class="nav-brand" href="/">
      <img class="nav-mark" src="/images/temple-mark.png" alt="" width="34" height="34" decoding="async" />
      <span>Temple XV</span>
    </a>
    <ul class="nav-links" id="nav-links" role="list">
      {
        routes.map((r) => (
          <li>
            <a href={`/${r.path}`} aria-current={active?.path === r.path ? 'page' : undefined}>
              {r.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="nav-actions">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
        <span class="nav-bars" aria-hidden="true"><span class="nav-bar"></span><span class="nav-bar"></span></span>
        <span class="sr-only">Menú</span>
      </button>
      <a class="btn btn-solid btn-sm" href="/contacto">Pedir</a>
    </div>
  </div>
</nav>
